# ===== SmartScreener 后端配置 =====
# 数据库（默认 SQLite，生产可切 Postgres）
DATABASE_URL=sqlite:///./smartscreener.db

# LLM 提供商：openai | ollama
LLM_PROVIDER=ollama

# OpenAI 兼容配置
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 本地 Ollama 配置（隐私优先，推荐）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== 合规开关（重要）=====
# 严格合规版默认 false：性别/年龄/婚育等受保护属性禁止用于自动筛选
# 仅在法务确认的特定岗位可临时开启，并需配置白名单 + 审计日志
ALLOW_PROTECTED_ATTRIBUTE_FILTERING=false
PROTECTED_ATTR_WHITELIST_ROLES=[]
